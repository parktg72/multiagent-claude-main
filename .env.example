# Keep real tokens and credentials out of this file.
# Dispatcher refuses a real external-model call unless this exact opt-in is 1.
MULTIAGENT_ALLOW_BILLABLE=0

# Optional, explicit read-only auth directory mounted as /auth inside sandbox.
# Requires a declared and separately approved secret_access action.
# Provider-specific auth integration remains endpoint-unverified.
# MULTIAGENT_AUTH_DIR=/absolute/path/to/dedicated-auth-dir

# Alternative explicit risk: forward a small provider-key allowlist to child CLI.
# Requires a declared and separately approved secret_access action.
MULTIAGENT_ALLOW_AUTH_ENV=0

# Test harness only. Never use for production dispatch; both values are required to
# select repository fixtures, and approval still requires interactive typed APPROVE.
# MULTIAGENT_TEST_MODE=1
# MULTIAGENT_TEST_SENTINEL=fixture-only-dispatch

# Test harness only. Relocates private runtime storage (approval journal, writer lock,
# reviewer packets) so a suite run never writes into the real .runtime. Requires the
# exact test-mode pair above and an absolute path inside the project; set without that
# pair it is a hard error, never a silent redirect of the authoritative journal.
# MULTIAGENT_TEST_RUNTIME_DIR=/absolute/path/inside/project
