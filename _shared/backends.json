{
  "schema_version": "1.0",
  "orchestrator": {
    "kind": "claude-code-interactive",
    "model_id": "claude-opus-5",
    "effort": "high",
    "launcher": "bin/claude-main",
    "fallback_policy": "forbid",
    "note": "Claude Code interactive session is main. It is not a worker record."
  },
  "workers": {
    "codex-sol": {
      "kind": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "access": "workspace-write",
      "sandbox": "danger-full-access",
      "timeout_s": 900,
      "requires_no_yes_man": false,
      "fallbacks": [],
      "fallback_policy": "forbid",
      "roles": ["implementation", "debugging", "testing"],
      "write_gate": "planned workers_approved + runtime approval journal + target_repo + write_scope + bwrap"
    },
    "codex-terra": {
      "kind": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "max",
      "access": "read-only",
      "sandbox": "read-only",
      "timeout_s": 900,
      "requires_no_yes_man": true,
      "fallbacks": [],
      "fallback_policy": "forbid",
      "roles": ["independent-review", "verification", "regression-analysis"]
    },
    "agy": {
      "kind": "agy",
      "command": "agy",
      "model": "gemini-3.1-pro-high",
      "effort": "high",
      "access": "read-only",
      "timeout_s": 900,
      "requires_no_yes_man": true,
      "fallbacks": [],
      "fallback_policy": "forbid",
      "roles": ["third-party-review", "multimodal", "operations-analysis"],
      "preflight": "agy models must contain the exact model id either as a line that trims to it, or as the first of exactly two tab-separated fields whose second field is not blank; CLI flags must all be present"
    },
    "codex-luna": {
      "kind": "codex",
      "command": "codex",
      "model": "gpt-5.6-luna",
      "effort": "max",
      "access": "read-only",
      "sandbox": "read-only",
      "timeout_s": 900,
      "requires_no_yes_man": true,
      "fallbacks": [],
      "fallback_policy": "forbid",
      "roles": ["impact-analysis", "contested-verdict", "independent-review"],
      "preflight": "codex argv contract only; this backend has no catalog probe, so the exact pin is a human reading of the CLI model cache, never a dispatcher check"
    },
    "deepseek-reviewer": {
      "kind": "opencode",
      "command": "opencode",
      "model": "opencode/deepseek-v4-flash",
      "effort": "max",
      "access": "read-only",
      "timeout_s": 900,
      "requires_no_yes_man": true,
      "fallbacks": [],
      "fallback_policy": "forbid",
      "roles": ["enumerative-review", "per-file-audit", "independent-review"],
      "preflight": "opencode Zen catalog must expose the pinned max variant; this model also advertises low and high, which the dispatcher must never build"
    },
    "fable-advisor": {
      "kind": "claude",
      "command": "claude",
      "model": "claude-fable-5",
      "access": "read-only",
      "tools": "disabled",
      "session_persistence": "disabled",
      "timeout_s": 900,
      "requires_no_yes_man": true,
      "fallbacks": [],
      "fallback_policy": "forbid",
      "roles": ["critical-design-advice", "ambiguity", "security-risk", "regression-risk"],
      "preflight": "Claude CLI syntax only; exact endpoint remains unverified until explicitly approved dispatch"
    }
  }
}
