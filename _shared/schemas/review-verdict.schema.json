{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "No-yes-man reviewer verdict",
  "type": "object",
  "additionalProperties": false,
  "$comment": "Provider structured-output modes reject a schema whose required list omits any declared property, so every property is required here. Emptiness stays legal where the contract allows it: summary may be an empty string and recommendations an empty array, while evidence and risks keep their minimum sizes.",
  "required": ["verdict", "evidence", "unverified_claims", "risks", "summary", "recommendations"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "conditional", "insufficient_evidence"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "unverified_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_mode", "trigger", "impact", "evidence_or_locator", "mitigation"],
        "properties": {
          "failure_mode": {"type": "string", "minLength": 24},
          "trigger": {"type": "string", "minLength": 24},
          "impact": {"type": "string", "minLength": 24},
          "evidence_or_locator": {"type": "string", "minLength": 24},
          "mitigation": {"type": "string", "minLength": 24}
        }
      }
    },
    "summary": {"type": "string"},
    "recommendations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
