{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent reviewer input",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "requirements", "diff", "test_evidence"],
  "properties": {
    "question": {"type": "string", "minLength": 20},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "diff": {"type": "string", "minLength": 1},
    "test_evidence": {"type": "string", "minLength": 1},
    "artifact_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
