#!/usr/bin/env python3
"""Strict test-only OpenCode CLI; its catalog mirrors the pinned Zen K3 max variant."""

from __future__ import annotations

import json
import os
from pathlib import Path
import sys


HELP = "--pure --model --variant --format --dir --file"


def verdict() -> dict[str, object]:
    return {
        "verdict": "conditional",
        "evidence": ["Mock OpenCode received only an attached neutral review packet."],
        "unverified_claims": ["Mock catalog does not establish a live provider endpoint."],
        "risks": [{"failure_mode": "Large-context review can omit a changed file not present in the packet.", "trigger": "Packet assembly excludes a cross-cutting source path.", "impact": "Impact analysis can miss a regression in an unmounted source area.", "evidence_or_locator": "Review input schema names only supplied diff and test evidence as admissible material.", "mitigation": "Regenerate packet from an explicit changed-file manifest before dispatch."}],
        "summary": "Mock OpenCode fixture verdict for contract tests only.",
        "recommendations": [],
    }


def main() -> int:
    args = sys.argv[1:]
    if args == ["run", "--help"]:
        print(HELP)
        return 0
    if args == ["--pure", "--version"]:
        return startup()
    # Both pinned models live under the same Zen provider. DeepSeek deliberately
    # advertises `high` as well, so the fixture proves the dispatcher declines it.
    if args == ["--pure", "models", "opencode", "--verbose"]:
        print("opencode/kimi-k3")
        print(json.dumps({"id": "kimi-k3", "variants": {"max": {"reasoningEffort": "max"}}}))
        print("opencode/deepseek-v4-pro")
        print(json.dumps({"id": "deepseek-v4-pro", "variants": {"high": {"reasoningEffort": "high"}, "max": {"reasoningEffort": "max"}}}))
        return 0
    if len(args) >= 3 and args[:2] == ["--pure", "models"]:
        return 64
    if len(args) < 4 or args[:3] != ["--pure", "run", "--model"] or args[3] not in {"opencode/kimi-k3", "opencode/deepseek-v4-pro"}:
        return 64
    # The real CLI treats --file as an array option that consumes trailing
    # positionals, so the message must come before it. Refuse any other order.
    expected = ["--pure", "run", "--model", args[3], "--variant", "max", "--format", "json", "--dir", "/workspace"]
    if args[: len(expected)] != expected or len(args) != len(expected) + 4:
        return 64
    message, file_flag, packet, schema = args[len(expected) :]
    if file_flag != "--file" or packet != "/input/review-input.json" or schema != "/input/review-verdict.schema.json":
        return 64
    # This CLI cannot enforce a schema, so the message must carry the shape demand.
    if message.startswith("-") or "packet" not in message or "additional property" not in message:
        return 64
    # Mirror the real CLI: JSONL events, with the answer inside part.text. An earlier
    # fixture printed a {"result": ...} envelope the real binary never emits, which
    # made the extractor look correct while it could not read a live stream.
    print(json.dumps({"type": "step_start", "part": {"type": "step-start"}}))
    print(json.dumps({"type": "text", "part": {"type": "text", "text": json.dumps(verdict())}}))
    print(json.dumps({"type": "step_finish", "part": {"type": "step-finish"}}))
    return 0


def startup() -> int:
    hidden = os.environ.get("MOCK_STARTUP_MUST_HIDE")
    if hidden and Path(hidden).exists():
        return 73
    if os.environ.get("MOCK_STARTUP_FAIL") == "opencode":
        return 70
    print("mock opencode 1.0")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
